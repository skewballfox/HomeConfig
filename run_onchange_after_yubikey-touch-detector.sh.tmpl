{{- if .hasGUI -}}
#!/usr/bin/env bash
# (re)start the service when the pinned release changes: {{ .yubikeyTouchDetector.version }}
{{- if not .isMac }}
# ...or when the unit changes: {{ include "private_dot_config/systemd/user/yubikey-touch-detector.service" | sha256sum }}
{{- end }}
set -euo pipefail

{{ if .isMac -}}
label=com.github.maximbaz.yubikey-touch-detector
plist=~/Library/LaunchAgents/$label.plist
launchctl bootout "gui/$UID/$label" 2>/dev/null || true
launchctl bootstrap "gui/$UID" "$plist"
{{- else -}}
systemctl --user daemon-reload
# reenable: moves the old default.target.wants link to the current WantedBy
systemctl --user reenable yubikey-touch-detector.service
systemctl --user restart yubikey-touch-detector.service
{{- end }}
{{- end }}
