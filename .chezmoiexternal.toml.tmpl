
[".gnupg/gpg.conf"]
    type = "file"
    url = "https://raw.githubusercontent.com/drduh/YubiKey-Guide/master/config/gpg.conf"
    refreshPeriod = "168h"
    private = true
{{- if not .hasGUI }}
    filter.command = "sed"
    filter.args = ["-e", "s/use-agent/no-autostart/"]
{{- else }}
[".gnupg/gpg-agent.conf"]
    type = "file"
    url = "https://raw.githubusercontent.com/drduh/YubiKey-Guide/master/config/gpg-agent.conf"
    refreshPeriod = "168h"
    private = true
{{- if .isMac }}
{{-   $pinentry := lookPath "pinentry-mac" | default "/opt/homebrew/bin/pinentry-mac" }}
    filter.command = "sed"
    # uncomment the matching pinentry line (BSD sed can't do the one-line append below)
    filter.args = [
        "-E",
        "-e", 's|^[[:space:]]*#[[:space:]]*(pinentry-program[[:space:]]+{{ regexQuoteMeta $pinentry }})[[:space:]]*$|\1|',
    ]
{{- else }}
{{-   $pinentry := lookPath "pinentry" | default "/usr/bin/pinentry" }}
    filter.command = "sed"
{{-   $line := printf "pinentry-program %s" $pinentry }}
    # uncomment the matching pinentry line, or append one if upstream drops it
    filter.args = [
        "-E",
        "-e", '\|^[[:space:]]*(#[[:space:]]*)?pinentry-program[[:space:]]+{{ regexQuoteMeta $pinentry }}[[:space:]]*$| { s|.*|{{ $line }}|; h; }',
        "-e", '$ { x; /^pinentry-program/ { x; b; }; x; a {{ $line }}',
        "-e", '}',
    ]
{{- end }}
{{- end }}
{{- if .hasGUI }}
{{-   $ytd := .yubikeyTouchDetector }}
{{-   $target := printf "%s-%s" .chezmoi.os .chezmoi.arch }}
{{-   $triple := dict "darwin-arm64" "aarch64-darwin" "darwin-amd64" "x86_64-darwin" "linux-arm64" "aarch64-linux-gnu" "linux-amd64" "x86_64-linux-gnu" }}
{{-   if hasKey $ytd.sha256 $target }}

[".local/bin/yubikey-touch-detector"]
    type = "file"
    url = "https://github.com/maximbaz/yubikey-touch-detector/releases/download/{{ $ytd.version }}/yubikey-touch-detector-{{ index $triple $target }}"
    executable = true
    checksum.sha256 = "{{ index $ytd.sha256 $target }}"
{{-   end }}
{{- end }}
