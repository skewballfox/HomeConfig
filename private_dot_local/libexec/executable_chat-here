#!/bin/sh
# chat-here — attach to the background Claude Code session for $PWD,
# starting one (empty chat) if there is none.
#
# Bound to ctrl+a in fish (conf.d/chat-here.fish), bash (bashrc.d/chat-here) and
# nushell (autoload/chat-here.nu). While attached, the kitty user var
# claude_attached is set, and kitty turns ctrl+a into ctrl+z, which is how
# `claude attach` detaches (see kitty.conf). Claude has no rebindable detach.
set -eu

# Newest background session started in exactly $PWD (`--cwd` also matches
# subdirectories); `--all` includes stopped ones, which attach resumes.
session_for_cwd() {
    claude agents --json --all --cwd "$PWD" 2>/dev/null |
        jq -r --arg cwd "$PWD" \
            'map(select(.kind == "background" and .cwd == $cwd))
             | sort_by(.startedAt) | last | .id // empty'
}

# kitty user vars via OSC 1337; no-op outside kitty.
kitty_var() {
    [ -n "${KITTY_WINDOW_ID-}" ] || return 0
    if [ $# -gt 1 ]; then
        printf '\033]1337;SetUserVar=%s=%s\007' "$1" "$(printf %s "$2" | base64)"
    else
        printf '\033]1337;SetUserVar=%s\007' "$1"
    fi
}

id=$(session_for_cwd)
if [ -z "$id" ]; then
    claude --bg --name "$(basename -- "$PWD")" >/dev/null
    id=$(session_for_cwd)
    if [ -z "$id" ]; then
        echo "chat-here: started a session but couldn't find it" >&2
        exit 1
    fi
fi

# Clear the var however attach ends, so ctrl+a goes back to the shell.
trap 'kitty_var claude_attached' EXIT
trap 'exit 130' INT TERM HUP
kitty_var claude_attached 1
claude attach "$id"
