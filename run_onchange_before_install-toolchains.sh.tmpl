#!/usr/bin/env bash
set -e
export PATH="$HOME/.cargo/bin:$HOME/.local/bin:$PATH"

# Install rustup
command -v rustup >/dev/null || curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
. "$HOME/.cargo/env"
rustup component add rust-analyzer
rustup target add{{ range .packages.rustup_targets }} {{ . }}{{ end }}
# eBPF (bpfel-unknown-none) is tier 3: no prebuilt target, built with nightly + build-std
rustup toolchain install nightly --profile minimal --component rust-src

# Install cargo-binstall
command -v cargo-binstall >/dev/null || curl -L --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash
command -v cargo-install-update >/dev/null || cargo install cargo-update
cargo binstall -y{{ range .packages.cargo }} {{ . }}{{ end }}

# Install uv
command -v uv >/dev/null || curl -LsSf https://astral.sh/uv/install.sh | sh