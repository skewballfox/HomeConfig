{{- if .isMac -}}
#!/usr/bin/env bash
# macOS-only, one-time system fixes. Runs before files are applied, so before
# run_once_setup.sh does `gpg --recv-keys` over hkps.
set -e

# NOTE: disabled. If you experience issues installing cert-manager with brew,
# you may want to re-enable this to add the system root certificates to
# /etc/ssl/cert.pem.
#
# gpg's dirmngr can't verify hkps keyservers against the stock /etc/ssl/cert.pem;
# seed it with the system root certificates (keeping a backup).
# if [ ! -e /etc/ssl/cert.pem.bak ]; then
#     sudo cp /etc/ssl/cert.pem /etc/ssl/cert.pem.bak
#     security find-certificate -a -p /System/Library/Keychains/SystemRootCertificates.keychain \
#         | sudo tee /etc/ssl/cert.pem >/dev/null
#     gpgconf --reload dirmngr 2>/dev/null || true
# fi

# Rosetta, for the occasional x86_64-only tool
if [ "$(uname -m)" = arm64 ] && ! /usr/bin/pgrep -q oahd; then
    softwareupdate --install-rosetta --agree-to-license
fi

# nushell on macOS ignores XDG_CONFIG_HOME set from its own config, so set it
# for the whole GUI session via a LaunchAgent (survives reboots), and apply it
# to the running session now.
agent=~/Library/LaunchAgents/org.xdg.config-home.plist
mkdir -p "$(dirname "$agent")"
plist="$(cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.xdg.config-home</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/launchctl</string>
        <string>setenv</string>
        <string>XDG_CONFIG_HOME</string>
        <string>$HOME/.config</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
PLIST
)"
[ "$(cat "$agent" 2>/dev/null)" = "$plist" ] || printf '%s\n' "$plist" >"$agent"
[ "$(launchctl getenv XDG_CONFIG_HOME)" = "$HOME/.config" ] || launchctl setenv XDG_CONFIG_HOME "$HOME/.config"
{{- end }}
