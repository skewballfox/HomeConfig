# Native nushell completions, stored in ../completions.
#   uv, just: generated by the tools (`uv generate-shell-completion nushell`, `just --completions nushell`)
#   cargo docker gh git rustup claude komorebi pnpm ssh: nushell/nu_scripts custom-completions @ 4033ddf
#   skx: hand-translated from completions/skx.fish
# Everything else (atuin, direnv, hx, gpg, ...) falls through to carapace (autoload/carapace.nu);
# kargo is bridged to its own cobra completion by a carapace spec (kargo.yaml).
# Still uncovered: qlty, copilot (clap CLIs; carapace's clap bridge doesn't work with them).
use ($nu.default-config-dir | path join completions cargo-completions.nu) *
use ($nu.default-config-dir | path join completions docker-completions.nu) *
use ($nu.default-config-dir | path join completions gh-completions.nu) *
use ($nu.default-config-dir | path join completions git-completions.nu) *
use ($nu.default-config-dir | path join completions rustup-completions.nu) *
use ($nu.default-config-dir | path join completions claude-completions.nu) *
use ($nu.default-config-dir | path join completions komorebi-completions.nu) *
use ($nu.default-config-dir | path join completions pnpm-completions.nu) *
use ($nu.default-config-dir | path join completions ssh-completions.nu) *
use ($nu.default-config-dir | path join completions uv-completions.nu) *
use ($nu.default-config-dir | path join completions just-completions.nu) *
use ($nu.default-config-dir | path join completions skx-completions.nu) *
